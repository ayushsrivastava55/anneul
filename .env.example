# Copy to .env and fill in. Values come from the team privately - never commit them.
# All providers are OpenAI-compatible; specs/models.yaml maps tiers to these vars.

# Anthropic (frontier/mid/cheap tiers)
FRONTIER_BASE_URL=https://api.anthropic.com/v1/
FRONTIER_API_KEY=

# TensorMux (flash tier, glm-4-7-flash, 60 RPM)
TENSORMUX_BASE_URL=https://api.tensormux.com/v1
TENSORMUX_API_KEY=

# AI Grants India (nano tier, gpt-5-nano)
AIGI_BASE_URL=https://api.openai.com/v1
AIGI_API_KEY=

# Neatlogs tracing + prompt registry
NEATLOGS_API_KEY=
NEATLOGS_WORKFLOW=anneal

# smallest.ai voice credits (unused)
SMALLEST_API_KEY=

# Dodo Payments (test mode; never obtained during the hackathon)
DODO_API_KEY=
DODO_ENV=test
DODO_CUSTOMER_ID=

# AO daemon (desktop app must be running)
AO_PORT=3001
AO_PROJECT=anneal
AO_AGENT=claude-code

# Run defaults
ANNEAL_CONCURRENCY=6
ANNEAL_HOLDOUT_RUNS=3

# Local inference (Ollama, OpenAI-compatible). No real key; the SDK requires a non-empty string.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
