# Copy to .env and fill in. Values come from the team privately - never commit them.
# All providers are OpenAI-compatible; specs/models.yaml maps tiers to these vars.
#
# YOU DO NOT NEED ANY API KEY TO RUN THIS. See "Zero-key setup" at the bottom.
# Every module below degrades cleanly when its key is absent, and says so at startup.

# --- inference providers -------------------------------------------------------------------
# Which of these you need depends entirely on the ladder in ANNEAL_MODELS_PATH.
# specs/models.yaml (shipped)      -> Anthropic + TensorMux + AI Grants India
# specs/models.local.yaml (no key) -> Ollama only

# Anthropic, via its OpenAI-compatibility endpoint (frontier/mid/cheap tiers of the shipped ladder)
FRONTIER_BASE_URL=https://api.anthropic.com/v1/
FRONTIER_API_KEY=

# TensorMux (flash tier, glm-4-7-flash). Enforces 60 requests/min; anneal/llm.py backs off on 429.
TENSORMUX_BASE_URL=https://api.tensormux.com/v1
TENSORMUX_API_KEY=

# AI Grants India (nano tier, gpt-5-nano)
AIGI_BASE_URL=https://api.openai.com/v1
AIGI_API_KEY=

# Local inference via Ollama. No real key exists; the OpenAI SDK just requires a non-empty string.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

# --- observability and billing (both optional) ---------------------------------------------
# Unset NEATLOGS_API_KEY: spans become no-ops and Diagnose reads traces from the local run rows
# instead of the Neatlogs MCP server. The loop is unaffected.
NEATLOGS_API_KEY=
NEATLOGS_WORKFLOW=anneal

# Unset DODO_API_KEY: billing runs as a local ledger. --budget is still enforced either way.
DODO_API_KEY=
DODO_ENV=test
DODO_CUSTOMER_ID=
DODO_CUSTOMER_EMAIL=

# --- AO daemon ------------------------------------------------------------------------------
# Needed only for the synthesize_tool operator, which spawns a real AO worker to write a missing
# tool. The desktop app must be running. Everything else works without it.
AO_PORT=3001
AO_PROJECT=anneal
AO_AGENT=claude-code

# --- run defaults (all optional; the values shown are the built-in defaults) -----------------
# Which ladder every module resolves against. --models sets the same thing for one invocation.
ANNEAL_MODELS_PATH=specs/models.yaml
# Tier used to classify failures. This picks which repair operator runs, so it wants a capable
# model; the cheapest tier returned unusable classes in a live run.
ANNEAL_CLASSIFIER_TIER=frontier
ANNEAL_CONCURRENCY=6
ANNEAL_HOLDOUT_RUNS=3
# Transport limits. The connect default is deliberately generous: a memory-constrained Ollama
# evicting one model to load another takes far longer than the SDK's 5s default allows.
ANNEAL_CONNECT_TIMEOUT=60
ANNEAL_READ_TIMEOUT=600
ANNEAL_LLM_RETRIES=2
# Credit accounting for the Dodo ledger, and the gate's escalation threshold.
ANNEAL_TOKENS_PER_USD=
ANNEAL_GATE_ESCALATION=

# --- Zero-key setup --------------------------------------------------------------------------
# 1. brew install ollama && ollama serve
# 2. ollama pull qwen2.5:3b-instruct qwen2.5:1.5b-instruct qwen2.5:0.5b-instruct
# 3. set ANNEAL_MODELS_PATH=specs/models.local.yaml  (or pass --models specs/models.local.yaml)
# On an 8GB machine also export OLLAMA_MAX_LOADED_MODELS=1 and OLLAMA_NUM_PARALLEL=1, or the run
# will be OOM-killed with three models resident.
#
# Non-environment prerequisites:
#   node + npx  - domains/filesystem launches the real @modelcontextprotocol/server-filesystem
#   AO desktop  - only for synthesize_tool

# --- demo video narration -------------------------------------------------------------
# Sarvam text-to-speech, used only by video/script/tts.py to voice the demo film. Nothing in
# anneal/ reads it and no run needs it. Get one at https://dashboard.sarvam.ai
SARVAM_API_KEY=
