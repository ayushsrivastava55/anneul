# Secrets — never commit
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Anneal artifacts: runs are regenerated; only the final reported set is tracked
runs/*
!runs/final/
# the unseen-domain evidence: two domains this repo had never seen, created through
# `anneal init` and run end to end. Tracked because it is the claim, not a scratch run.
!runs/unseen/
!runs/.gitkeep
prompts/cache/

# Tools synthesised by AO workers, tracked only once promoted
domains/*/generated_tools/*
!domains/*/generated_tools/.gitkeep

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Media and logs
*.mp4
*.log

# local dev-env bootstrap (uv + managed pythons), not part of the project
.tooling/

# The demo film. The sources are tracked: the script, the components, the captured shots.
# What is generated from them is not: node_modules, the narration WAVs (regenerated from the
# script with a Sarvam key) and the renders themselves, which are hundreds of megabytes.
video/node_modules/
video/out/
video/public/audio/
